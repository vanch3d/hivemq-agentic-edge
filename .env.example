# Anthropic API key — required for the AI chat agent
# Get yours at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Model to use (optional, defaults to claude-sonnet-4-5-20250514)
# Options: claude-sonnet-4-5-20250514, claude-haiku-3-5-20241022, etc.
ANTHROPIC_MODEL=claude-sonnet-4-5-20250514
