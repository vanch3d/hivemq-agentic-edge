# AI Provider: "anthropic" or "ollama" (defaults to "anthropic")
AI_PROVIDER=anthropic

# Anthropic settings (required when AI_PROVIDER=anthropic)
# Get your key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-5

# Ollama settings (required when AI_PROVIDER=ollama)
# Install Ollama from https://ollama.com then: ollama pull llama3.1
OLLAMA_MODEL=llama3.1
OLLAMA_HOST=http://localhost:11434

# MSW mock toggles (dev only, ignored in production)
VITE_MOCK_EDGE_API=true    # Mock HiveMQ Edge REST API
VITE_MOCK_AGENT_CHAT=false # Mock /api/chat SSE (for testing without AI provider)
